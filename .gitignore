.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/

# OS
Thumbs.db
.DS_Store

# Release zips
dist/

# The baked AssetBundle. It is a BUILD INPUT that ships INSIDE the DLL as an embedded resource
# (models\SETUP-FOR-CLAUDE.md section 3), never in git: WORKSPLIT section 4 allows exactly two
# binaries in this repo and they are the body's source art, not its build output.
# tools\setup-ingvar-unity.ps1 -Embed puts the bundle here; rebuild it, do not commit it.
/Assets/

# Corrupt files (test outputs, etc)
*.corrupt

# Source art. WORKSPLIT §4 allows exactly two binaries in the repo - models\ingvar.fbx and
# models\ingvar_albedo.png, the body's build inputs. Everything below is Meshy's raw per-clip
# output: six files, each carrying a duplicate copy of the mesh AND 22 MB of the same textures,
# 343 MB for six views of one dwarf. tools\build_ingvar.py regenerates all of it.
models/ingvar.glb
models/10ktridwarf.glb
models/dwarf_*.glb
models/dwarf_*.fbx
models/ingvar_*.glb
models/ingvar_*.fbx
models/preview/*_[0-9][0-9].png
models/preview/row_*.png
models/preview/nod/nod_[0-9][0-9].png

# Claude Code session state and agent worktrees. Never ours to ship, and a worktree
# committed as a gitlink is a clone nobody else can resolve.
.claude/

# The built payload (owner, 2026-09-07): the packager writes the DLL here for the store upload, and a
# payload is a GitHub release asset, never a commit. WORKSPLIT section 4; docs/RELEASE.md.
HexiumDist/plugins/
