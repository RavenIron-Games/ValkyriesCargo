<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches the SDK installed here. RollForward=LatestMajor keeps it running when the
         runtime moves on: the harness needs *a* modern runtime, not a specific one. -->
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <AssemblyName>CoreTests</AssemblyName>
    <RootNamespace>ValkyriesCargo.Tests</RootNamespace>
    <!-- The mod targets net472 and needs Mono to run. These files' *logic* has no Unity
         dependency, so compiled against stubs they run on any modern .NET. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Stubs.cs" />

    <!--
      THE SHIPPING SOURCE, not a copy. A harness that duplicates the logic proves nothing
      about the logic that ships, and drifts apart from it silently.
    -->
    <Compile Include="..\..\ValkyriesCargo\Core\Catalogue.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\Wire.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\MarketSnapshot.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\VisitSnapshot.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\Deal.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\DemoMarket.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\Market.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\Scheduler.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\VisitClock.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\FlightPlan.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\MerchantPlan.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\Keys.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\VisitSession.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\Lines.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\Sidecar.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\OwedLedger.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\TraderLedger.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\VisitHistory.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\BarrkRollover.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\BarrkExport.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\SidecarThenMirror.cs" />
    <Compile Include="..\..\ValkyriesCargo\Core\BodyMotion.cs" />
    <Compile Include="..\..\ValkyriesCargo\Client\Terminal\TrayModel.cs" />
    <Compile Include="..\..\ValkyriesCargo\Net\CargoRpc.cs" />
  </ItemGroup>

</Project>
